+# Efficient-RSI fix (HGM_DIAG_CLIP=1, set by `run_all.sh v2`; off by default so earlier runs keep
+# upstream behaviour): clip the parts of the diagnose prompt that upstream leaves unbounded. With a
+# 131k-token model, a parent whose solution patch held tens of millions of characters (generated
+# files) made every diagnose call fail, so the parent could never get a child. Upstream already clips
+# md_log at 100k characters and has these clips commented out. Limits are in characters. Measured with
+# the Qwen3-Coder tokenizer on the largest first-run files: logs 3.3-3.9 characters per token, the
+# largest solution patches 2.6. CLIP_TOTAL = 300k characters is then at most ~115k tokens, under the
+# 131,072-token context minus the 4,096 output tokens.
+DIAG_CLIP = os.getenv("HGM_DIAG_CLIP", "0") == "1"
+CLIP_CODE = int(os.getenv("HGM_DIAG_CLIP_CODE", "120000"))
+CLIP_PATCH = int(os.getenv("HGM_DIAG_CLIP_PATCH", "50000"))
+CLIP_EVAL_LOG = int(os.getenv("HGM_DIAG_CLIP_EVAL_LOG", "30000"))
+CLIP_TOTAL = int(os.getenv("HGM_DIAG_CLIP_TOTAL", "300000"))
+# The diagnose templates end with the JSON answer format the reply is parsed against, so a prompt
+# that is still too long is cut in the middle (the logs), keeping this many characters at the end.
+CLIP_KEEP_TAIL = 8000
+
+
+def clip(text, limit, what):
+    if not DIAG_CLIP or text is None or len(text) <= limit:
+        return text
+    return text[:limit] + f"\n<{what} clipped: {len(text) - limit} more characters>"
+
+
+def fit_prompt(system_message, prompt, limit, keep_tail=CLIP_KEEP_TAIL):
+    """Shorten prompt so that system_message + prompt stays within limit characters.
+
+    Cuts from the middle, so the beginning (the task and the agent's log) and the end (the answer
+    format) both survive. Returns the prompt unchanged when it already fits.
+    """
+    room = limit - len(system_message)
+    if len(system_message) + len(prompt) <= limit:
+        return prompt
+    tail = min(keep_tail, max(0, room // 2))
+    marker = f"\n<... {{}} characters clipped to fit the model's context ...>\n"
+    head = max(0, room - tail - len(marker) - 12)
+    cut = len(prompt) - head - tail
+    return prompt[:head] + marker.format(cut) + (prompt[-tail:] if tail else "")
+
+
