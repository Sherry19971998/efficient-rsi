# Machine-specific settings. Copy to env.sh (ignored by git) and adjust; run_all.sh sources it.
# Paths default to this checkout, so nothing here is tied to one machine.
export RSI_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Temp files and pip cache on a disk with room (on the original server the system disk was full)
export TMPDIR="$RSI_HOME/tmp"
export PIP_CACHE_DIR="$RSI_HOME/cache/pip"
mkdir -p "$TMPDIR" "$PIP_CACHE_DIR"

# vLLM lives in its own venv (its numpy clashes with other environments)
export VLLM_BIN="$HOME/venvs/vllm/bin/vllm"

# docker0 address; the metering proxy binds here so only local containers reach it.
# Check with: ip -4 addr show docker0
export BRIDGE=172.17.0.1

# Hugging Face cache for the ~31 GB model weights (default ~/.cache/huggingface)
# export HF_HOME=/data/hf

# Git identity for the Polyglot dataset preparation commits, without touching the global config
export GIT_AUTHOR_NAME=efficient-rsi GIT_AUTHOR_EMAIL=efficient-rsi@localhost
export GIT_COMMITTER_NAME=efficient-rsi GIT_COMMITTER_EMAIL=efficient-rsi@localhost

# Hide each task's tests and reference solution from the solving agent (repos/HGM/polyglot/test_spec.py).
# Keep this on: upstream images leave the answers inside the agent's container. Images built with it
# are named pb.eval.<arch>.<task>.hidden, so evaluate the initial agent (./run_all.sh init) with it on too.
export HGM_HIDE_ANSWERS=1
